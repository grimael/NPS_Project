# Used by src/generate_verbatims.py to synthesize customer verbatims.
# Never commit the real .env file.

# "gemini" (default, used for the final committed verbatims.csv, batched —
# see docs/decisions.md D29), "groq" (free/cheap stand-in used earlier to
# validate the pipeline), or "anthropic" (an earlier planned paid path, not
# used in the end). Swapping providers is a one-line change here, never a
# code change.
VERBATIM_PROVIDER=gemini

# Required when VERBATIM_PROVIDER=gemini (or unset). Get a key at
# aistudio.google.com/apikey.
GEMINI_API_KEY=

# Required when VERBATIM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Required when VERBATIM_PROVIDER=groq. Get a free key at console.groq.com.
GROQ_API_KEY=
